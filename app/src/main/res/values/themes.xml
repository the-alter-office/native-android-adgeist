<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.NativeandroidadgeistTheme" parent="Theme.Material3.Light.NoActionBar">
        <!-- Single teal theme used consistently across the whole example app -->
        <item name="colorPrimary">@color/teal_700</item>
        <item name="colorPrimaryVariant">@color/teal_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="colorError">@color/design_default_color_error</item>
        <item name="colorOnError">@color/white</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/black</item>
        <item name="android:statusBarColor">@color/teal_700</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.NativeandroidadgeistTheme" parent="Base.Theme.NativeandroidadgeistTheme" />
</resources>