<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- AdView custom attributes -->
    <declare-styleable name="AdView">
        <attr name="adUnitId" format="string" />
        <!-- Optional stable slot identity; auto-derived when omitted. Sessions
             are resumed only by the same placement. -->
        <attr name="placementId" format="string" />
    </declare-styleable>
</resources>
